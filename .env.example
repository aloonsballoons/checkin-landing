# CheckIn — waitlist landing page
#
# These are OPTIONAL. With no env vars set, the waitlist form still works:
# submissions are validated, logged to the server console, and return success.
# Set both of the values below to persist signups to the shared Supabase
# `waitlist` table. See the README for the CREATE TABLE SQL.

# Your shared Supabase project URL (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service role key (server-side only — never expose to the browser).
# Found in: Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
